# QUAD Java - Backend Environment Variables
# Copy to .env and edit values, or set directly in your shell environment

# =============================================================================
# OpenAI / LLM Settings
# =============================================================================

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# UI Settings (read by UiConfig from environment)
# =============================================================================

QUAD_DUMMY_MODE=true
QUAD_COST_LIMIT=1.0
QUAD_TOOLS=readFile,writeFile,webSearch
QUAD_WORKSPACE=/work/quad-ui
QUAD_SKILLS_DIR=/home/torsten/dev/my-projects/nooa/quad/skills

# =============================================================================
# Server Settings
# =============================================================================

QUAD_PORT=8086

# =============================================================================
# Debug Mode
# =============================================================================

# QUAD_DEBUG=true   # Enable Java debug on port 5005

# =============================================================================
# Usage
# =============================================================================
# Set environment variables directly:
#   export OPENAI_API_KEY="sk-..."
#   export OPENAI_MODEL="gpt-4o-mini"
#   ./start-backend.sh
#
# Or with debug:
#   QUAD_DEBUG=true ./start-backend.sh
#
# Check UI status API:
#   curl http://localhost:8086/api/ui/status