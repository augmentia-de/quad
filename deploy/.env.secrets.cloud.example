# ── Cloud Secrets ──────────────────────────────────────────────
# Kopiere diese Datei nach .env.secrets.cloud und befülle die Werte.
# ACHTUNG: NIEMALS in Git committen!
#
# Nutzen:
#   source deploy/.env.secrets.cloud
#   oder automatisch via scripts/start.sh / scripts/deploy.sh

# ---- GCP Project ----
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1

# ---- OpenAI API Key ----
CLOUD_OPENAI_API_KEY=sk-...

# ---- MCP (optional) ----
CLOUD_MCP_ENABLED=false
CLOUD_MCP_CONFIG_PATH=/workspace/mcp-config.json
