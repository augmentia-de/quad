# .env.test — Environment for integration tests (LLM + E2E)
#
# Usage:
#   source .env.test && mvn test -Pintegration-tests -pl quad-quarkus
#   source .env.test && mvn test -Pintegration-tests -pl quad-core

# ── LLM Settings ───────────────────────────────────────────────
# Required: API key for real LLM calls during integration tests
OPENAI_API_KEY=

# OpenAI-compatible base URL (OpenRouter, Azure, etc.)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model to use for test runs
OPENAI_MODEL=deepseek/deepseek-chat

# ── Test Mode ──────────────────────────────────────────────────
# Set to "false" to use real LLM in Quarkus integration tests
QUAD_DUMMY_MODE=false

# Cost limit per test session (USD) — aborts if exceeded
QUAD_COST_LIMIT=0.50

# ── Quarkus Test Settings ──────────────────────────────────────
QUARKUS_HTTP_PORT=8086

# Logging: set to DEBUG for verbose test output
QUARKUS_LOG_LEVEL=INFO
QUARKUS_LANGCHAIN4J_LOG_REQUESTS=false
QUARKUS_LANGCHAIN4J_LOG_RESPONSES=false

# ── OTel (optional — set if running dev infra) ─────────────────
# QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
