<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.augmentia.quad</groupId>
    <artifactId>quad</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>QUAD Java - Native Open Agent Orchestration</name>
    <description>Java/Quarkus port of QUAD with LangChain4j and Strands-inspired agent composition</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <quarkus.platform.version>3.33.2</quarkus.platform.version>
        <quarkus-langchain4j.version>1.10.0</quarkus-langchain4j.version>
        <langchain4j.version>1.15.0</langchain4j.version>
        <langchain4j-mcp.version>1.15.0-beta25</langchain4j-mcp.version>
        <surefire-plugin.version>3.2.5</surefire-plugin.version>

        <!-- Testcontainers versions -->
        <testcontainers.version>1.20.2</testcontainers.version>
        <caffeine.version>3.1.8</caffeine.version>
        <assertj.version>3.26.3</assertj.version>
        <diff-utils.version>5.3.0</diff-utils.version>
        <micrometer.version>1.14.5</micrometer.version>
        <enforcer-plugin.version>3.6.3</enforcer-plugin.version>
        <elasticsearch-java.version>8.12.2</elasticsearch-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-tool-builtin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-tool-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-sandbox-docker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-workflow-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-workflow-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.augmentia.quad</groupId>
                <artifactId>quad-quarkus-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Kein globales <dependencies>-Block mehr.

        Vorher standen hier jakarta.inject, jakarta.enterprise.cdi-api,
        jakarta.ws.rs-api, jackson-databind und langchain4j als normale
        (compile-)Abhaengigkeiten fuer JEDES Modul. Damit war die
        Framework-Neutralitaet der einzelnen Module nicht durchsetzbar: der
        Enforcer-Ban auf io.quarkus griff zwar, aber jedes Modul bekam CDI und
        JAX-RS zwangsweise auferlegt - auch quad-contract und
        quad-workflow-engine, die genau davon frei sein sollen.

        Die Abhaengigkeiten sind jetzt pro Modul deklariert, wo sie gebraucht
        werden. dependencyManagement (BOMs + eigene Versionen) bleibt unberuehrt.
    -->

    <modules>
        <module>quad-core</module>
        <module>quad-workflow-core</module>
        <module>quad-tool-builtin</module>
        <module>quad-tool-mcp</module>
        <module>quad-sandbox-docker</module>
        <module>quad-contract</module>
        <module>quad-workflow-engine</module>
        <module>quad-quarkus-core</module>
        <module>quad-quarkus</module>
        <module>quad-examples</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>11.14.1</version> <!-- Use your Flyway version -->
                <configuration>
                    <url>jdbc:sqlite:${project.basedir}/data/quad.db</url>
                    <locations>
                        <location>filesystem:src/main/resources/db/migration/sqlite</location>
                    </locations>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.xerial</groupId>
                        <artifactId>sqlite-jdbc</artifactId>
                        <version>3.45.1.0</version>
                    </dependency>
                </dependencies>
            </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <!--
                            TODO2 A1: ReflectiveToolMethod nutzt param.getName() als Fallback,
                            wenn ein @Tool-Parameter kein @Param traegt. Ohne diese Flag liefert
                            der Compiler "arg0", "arg1", ... — das LLM sendet dann den echten
                            Namen, das Binding findet nichts, und der Parameter bleibt null,
                            OHNE Exception. Alle Builtin-Tools tragen @Param und umgingen das
                            bislang; jedes neue Tool ohne @Param faellt in das Loch.
                            Der Parameter-Name ist Teil des JSON-Schemas, also nicht optional.
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <!--
                            Diese Tests brauchen ein laufendes Backend (localhost:8086),
                            ein LLM oder ein Kafka-Broker und gehoeren darum NICHT in
                            den Default-Build. Ausfuehren mit -Pintegration-tests.

                            Achtung: JUnit-Tags matchen exakt. "e2e-llm" ist ein eigenes
                            Tag und wird von "e2e" nicht miterfasst - es muss hier
                            ausdruecklich genannt sein, sonst laeuft der Test mit und
                            scheitert im Default-Build an "Connection refused".
                        -->
                        <excludedGroups>llm,e2e,e2e-llm</excludedGroups>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                </plugin>
                <!--
                    Grenzwaechter zwischen framework-neutralem Kern und
                    Quarkus-Adapter. Wird von den Modulen mit eigener Regel
                    konfiguriert.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>integration-tests</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <version>${surefire-plugin.version}</version>
                            <configuration>
                                <excludedGroups combine.self="override"/>
                                <groups>llm,e2e,e2e-llm</groups>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>