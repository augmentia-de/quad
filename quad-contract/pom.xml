<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.augmentia.quad</groupId>
        <artifactId>quad</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>quad-contract</artifactId>
    <name>QUAD - REST Contract DTOs</name>
    <description>
        Framework-neutral DTOs of the REST contract. Extracted from quad-quarkus
        because both the workflow engine and the app need these types -
        an app-internal package (quarkus.contract) would be a wrong dependency.
    </description>

    <dependencies>
        <!--
            Deliberately NO Jackson dependency: the DTOs are pure data holders with
            getters/setters. Serialisation is done by the client (Quarkus RESTEasy /
            Spring Jackson), not by this module.
        -->

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
            </plugin>

            <!--
                Boundary guard: a contract that is used by the engine AND the app
                must not contain a framework import. Otherwise
                exactly recreates the coupling this module is supposed to resolve.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-frameworks</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>io.quarkus:*</exclude>
                                        <exclude>io.quarkiverse:*</exclude>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>jakarta.ws.rs:*</exclude>
                                        <exclude>jakarta.enterprise:*</exclude>
                                    </excludes>
                                    <message>
                                        quad-contract is the framework-neutral REST contract.
                                        Framework references belong in the app or in the
                                        native hints of quad-quarkus-core.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>