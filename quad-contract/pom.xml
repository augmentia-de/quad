<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.augmentia.quad</groupId>
        <artifactId>quad</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>quad-contract</artifactId>
    <name>QUAD - REST Contract DTOs</name>
    <description>
        Framework-neutrale DTOs des REST-Vertrags. Ausgelagert aus quad-quarkus,
        weil sowohl die Workflow-Engine als auch die App diese Typen brauchen -
        ein App-internes Paket (quarkus.contract) waere eine falsche Abhaengigkeit.
    </description>

    <dependencies>
        <!--
            Bewusst KEINE Jackson-Dependency: die DTOs sind reine Datenhalter mit
            Gettern/Settern. Serialisierung macht der Client (Quarkus RESTEasy /
            Spring Jackson), nicht dieses Modul.
        -->

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
            </plugin>

            <!--
                Grenzwaechter: ein Vertrag, der von der Engine UND der App benutzt
                wird, darf keinen Framework-Import enthalten. Sonst schleicht sich
                genau die Kopplung wieder ein, die dieses Modul aufloesen soll.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-frameworks</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>io.quarkus:*</exclude>
                                        <exclude>io.quarkiverse:*</exclude>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>jakarta.ws.rs:*</exclude>
                                        <exclude>jakarta.enterprise:*</exclude>
                                    </excludes>
                                    <message>
                                        quad-contract ist der framework-neutrale REST-Vertrag.
                                        Framework-Hinweise gehoeren in die App bzw. in die
                                        Native-Hints von quad-quarkus-core.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>