{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quad.augmentia.de/schema/workflow/quad.workflow.v1.schema.json",
  "title": "QUAD Workflow Document v1",
  "description": "Deterministic validation schema for the export/import of QUAD workflows (quad.workflow.v1). Validated against the payload before every import. The envelope contains exactly one main workflow (mainWorkflowId or workflows[0]), recursively bundled sub-workflows (nested-workflow) and all referenced agents. Nodes are intentionally free (UI contract {id,type,title,config} AND compiler contract {id,label,nodeType,properties} are both allowed); the reference resolution (config/properties.agentId + .workflowId) happens deterministically in the import service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "workflows"],
  "properties": {
    "format": {
      "const": "quad.workflow"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mainWorkflowId": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": ["string", "null"]
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "nodes", "edges"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "initialTask": { "type": ["string", "null"] },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "target"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "temperature": { "type": "number" },
        "maxTokens": { "type": "integer", "minimum": 0 },
        "topP": { "type": "number" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "guardrailsInput": { "type": "array", "items": { "type": "string" } },
        "guardrailsOutput": { "type": "array", "items": { "type": "string" } },
        "hooks": { "type": "array", "items": { "type": "string" } },
        "timeoutSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "systemPrompt": { "type": ["string", "null"] },
        "userMessageTemplate": { "type": ["string", "null"] },
        "jsonOutput": { "type": "boolean" },
        "jsonOutputSchema": { "type": ["string", "null"] },
        "chatParameters": { "type": ["object", "null"] },
        "agentType": { "type": ["string", "null"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}