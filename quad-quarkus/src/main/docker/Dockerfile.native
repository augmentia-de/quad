# ==== Stage 1: Build all modules ====
FROM maven:3.9-eclipse-temurin-21 AS build
USER root
RUN mkdir -p /project
WORKDIR /project

COPY pom.xml .

# All reactor modules (must match root pom.xml modules)
COPY quad-core/pom.xml quad-core/pom.xml
COPY quad-core/src quad-core/src
COPY quad-workflow-core/pom.xml quad-workflow-core/pom.xml
COPY quad-workflow-core/src quad-workflow-core/src
COPY quad-tool-builtin/pom.xml quad-tool-builtin/pom.xml
COPY quad-tool-builtin/src quad-tool-builtin/src
COPY quad-tool-mcp/pom.xml quad-tool-mcp/pom.xml
COPY quad-tool-mcp/src quad-tool-mcp/src
COPY quad-sandbox-docker/pom.xml quad-sandbox-docker/pom.xml
COPY quad-sandbox-docker/src quad-sandbox-docker/src
COPY quad-search-elasticsearch/pom.xml quad-search-elasticsearch/pom.xml
COPY quad-search-elasticsearch/src quad-search-elasticsearch/src
COPY quad-search-pgvector/pom.xml quad-search-pgvector/pom.xml
COPY quad-search-pgvector/src quad-search-pgvector/src
COPY quad-quarkus/pom.xml quad-quarkus/pom.xml
COPY quad-quarkus/src quad-quarkus/src
COPY quad-examples/pom.xml quad-examples/pom.xml
COPY quad-examples/src quad-examples/src

RUN mvn install -DskipTests -q -pl quad-quarkus -am

# ==== Stage 2: Native build with Mandrel ====
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25 AS native
USER root
COPY --from=build /usr/share/maven /usr/share/maven
RUN ln -s /usr/share/maven/bin/mvn /usr/local/bin/mvn
ENV HOME=/root
COPY --from=build /root/.m2/repository /root/.m2/repository
COPY --from=build /project /project
WORKDIR /project
RUN mvn package -Pnative -DskipTests -pl quad-quarkus -am \
    -Dquarkus.native.container-build=false

# ==== Stage 3: Minimal Runtime ====
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libc6 libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -r appuser -g 1001 && useradd -r -g appuser -u 1001 -m appuser
WORKDIR /work/
RUN chown 1001:1001 /work \
    && chmod "g+rwX" /work
COPY --from=native /project/quad-quarkus/target/*-runner /work/application
EXPOSE 8080
USER 1001
ENV QUARKUS_HTTP_HOST=0.0.0.0
CMD ["./application"]