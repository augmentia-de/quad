{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quad.augmentia.de/schemas/monitor.json",
  "title": "Monitor",
  "description": "Contracts for monitoring, audit and HITL endpoints.",
  "oneOf": [
    { "$ref": "#/$defs/tokenMetrics" },
    { "$ref": "#/$defs/errorMetrics" },
    { "$ref": "#/$defs/auditLogEntry" },
    { "$ref": "#/$defs/hitlApproval" }
  ],
  "$defs": {
    "tokenMetrics": {
      "type": "object",
      "title": "TokenMetrics",
      "description": "Antwort von GET /api/ui/metrics",
      "required": ["prompt", "completion", "total"],
      "properties": {
        "prompt": { "type": "integer", "minimum": 0 },
        "completion": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "errorMetrics": {
      "type": "object",
      "title": "ErrorMetrics",
      "description": "Antwort von GET /api/ui/metrics/errors",
      "required": ["toolCalls", "timeouts", "guardrails"],
      "properties": {
        "toolCalls": { "type": "integer", "minimum": 0 },
        "timeouts": { "type": "integer", "minimum": 0 },
        "guardrails": { "type": "integer", "minimum": 0 }
      }
    },
    "auditLogEntry": {
      "type": "object",
      "title": "AuditLogEntry",
      "required": ["id", "timestamp", "agent", "event", "details"],
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "agent": { "type": "string" },
        "event": { "type": "string", "examples": ["Tool Execution"] },
        "details": { "type": "string" }
      }
    },
    "hitlApproval": {
      "type": "object",
      "title": "HitlApproval",
      "required": ["id", "agent", "tool", "request", "since", "status"],
      "properties": {
        "id": { "type": "string" },
        "agent": { "type": "string" },
        "tool": { "type": "string" },
        "request": { "type": "string" },
        "since": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      }
    }
  }
}
